# -----------------------------------------------------------------------------
# Model weights (large binary files — download separately, see SETUP.md)
# -----------------------------------------------------------------------------
*.pt
*.pth
*.weights
*.onnx
*.tflite
*.pb

# Keep the weights/ directory itself (for README clarity) but ignore its contents
weights/*
!weights/.gitkeep

# -----------------------------------------------------------------------------
# Runtime-generated output files
# -----------------------------------------------------------------------------

# Tracked output videos written by pipeline.py and run_inference.py
tracked_video_*.mp4
tracked_*.mp4
*_h264.mp4

# Temporary processing files
temp_*.mp4
temp_*.csv

# Headless inference output directory
output/

# Evaluation prediction files (regenerated by evaluate.py)
evaluation/preds/

# Per-run results files (keep only the canonical results.md)
evaluation/results_*.md

